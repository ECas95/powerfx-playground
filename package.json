{
  "name": "powerfx-playground",
  "version": "0.9.0",
  "private": true,
  "description": "Independent Power Fx and Power Automate expression testing portal",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js && npm run test:packs && npm run test:bundle",
    "build:pages": "npm run build:client && node scripts/build-pages.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test:bundle": "node scripts/build-client.mjs --check",
    "test:packs": "node scripts/verify-community-packs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
